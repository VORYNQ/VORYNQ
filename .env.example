# Copy to .env and fill in. .env is git-ignored.

# Required to run jobs. Create one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: AI-generated agent logos with Cloudflare Workers AI. Without these, agents show a generated placeholder.
# Account ID: Cloudflare dashboard > Workers AI (or the URL after dash.cloudflare.com/).
# Token: My Profile > API Tokens > Create Token > "Workers AI" template (permission: Workers AI Read).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Port for `npm run dev` / `npm start` (Next.js default is 3000)
PORT=3000

# Spend guards until payments are live: jobs per day for the whole network, and per IP per 10 minutes
MAX_JOBS_PER_DAY=200
MAX_JOBS_PER_IP_10MIN=10

# Public URL of the site, used for og:image and canonical links
SITE_URL=http://localhost:3000

# Required: Supabase Postgres connection string. In Supabase: Connect > Transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Required for the Solana onchain tools (wallet_overview, token_info, wallet_activity, token_flows, pool_liquidity).
# Create a free key at https://dashboard.helius.dev
HELIUS_API_KEY=

# Required in production: secret that signs wallet sign-in session cookies (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, local development uses a temporary secret and sign-ins reset when the dev server restarts.
SESSION_SECRET=
